{
  "name": "dsh-custom-tool-studio",
  "version": "1.3.2",
  "license": "MIT",
  "type": "module",
  "description": "Custom tool studio: author Python tools in a Web page or through agent tools, then run them as first-class DSH tools. Dangerous tools require built-in approval before every execution. Optional per-conversation unlock mode (deferred tool loading) with always-unlocked packs and single-tool unlocks for ungrouped tools.",
  "icon": "icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "restore.ps1",
    "selfcheck.mjs",
    "README.md",
    "CONTRACT.md"
  ],
  "scripts": {
    "selfcheck": "node selfcheck.mjs",
    "test": "node test/run.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "cordis",
    "python",
    "tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xtt-xt/dsh-custom-tool-studio.git"
  },
  "homepage": "https://github.com/xtt-xt/dsh-custom-tool-studio#readme",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "工具工作室",
      "en": "Tool studio"
    },
    "icon": "wrench",
    "contributes": {
      "composer.actions": [
        {
          "id": "open-studio",
          "label": {
            "zh": "工具",
            "en": "Tools"
          },
          "icon": "wrench",
          "effect": {
            "type": "open",
            "page": "panel:studio"
          }
        }
      ],
      "composer.tools": [
        {
          "id": "new-tool",
          "label": {
            "zh": "新建工具",
            "en": "New tool"
          },
          "icon": "add"
        },
        {
          "id": "new-pack",
          "label": {
            "zh": "新建工具包",
            "en": "New pack"
          },
          "icon": "puzzle"
        }
      ],
      "session.actions": [
        {
          "id": "studio-side",
          "label": {
            "zh": "自定义工具",
            "en": "Custom tools"
          },
          "icon": "wrench",
          "effect": {
            "type": "open",
            "page": "panel:studio"
          }
        }
      ],
      "composer.strip": [
        {
          "id": "studio-count",
          "icon": "wrench",
          "panel": "studio"
        }
      ],
      "panels": [
        {
          "id": "studio",
          "title": {
            "zh": "自定义工具",
            "en": "Custom tools"
          },
          "icon": "wrench",
          "placement": [
            "session.tab",
            "features",
            "chat.panel",
            "plugin"
          ]
        },
        {
          "id": "tool",
          "title": {
            "zh": "工具",
            "en": "Tool"
          },
          "icon": "tool",
          "placement": [
            "session.tab",
            "features"
          ],
          "presentation": "sheet"
        },
        {
          "id": "pack",
          "title": {
            "zh": "工具包",
            "en": "Pack"
          },
          "icon": "puzzle",
          "placement": [
            "session.tab",
            "features"
          ],
          "presentation": "sheet"
        },
        {
          "id": "settings",
          "title": {
            "zh": "设置",
            "en": "Settings"
          },
          "icon": "settings",
          "placement": [
            "session.tab",
            "features",
            "plugin"
          ],
          "presentation": "sheet"
        }
      ]
    }
  }
}
